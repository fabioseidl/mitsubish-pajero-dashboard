{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pio run:*)",
      "Bash(pio test:*)",
      "Bash(pio project:*)",
      "Bash(pio device list:*)",
      "Bash(~/.platformio/penv/bin/pio run:*)",
      "Bash(~/.platformio/penv/bin/pio test:*)",
      "Bash(~/.platformio/penv/bin/pio project:*)",
      "Bash(~/.platformio/penv/bin/pio device list:*)",
      "Bash(command -v:*)",
      "Bash(g++ -fsyntax-only:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  }
}
